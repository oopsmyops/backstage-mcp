{
  "name": "backstage-mcp",
  "version": "1.1.0",
  "description": "Standalone MCP server for Backstage — catalog, scaffolder, and TechDocs tools for LLM clients",
  "license": "MIT",
  "type": "module",
  "main": "dist/backstage-mcp.mjs",
  "bin": {
    "backstage-mcp": "./dist/backstage-mcp.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oopsmyops/backstage-mcp.git"
  },
  "keywords": [
    "backstage",
    "mcp",
    "model-context-protocol",
    "llm",
    "ai",
    "developer-portal",
    "catalog",
    "scaffolder",
    "techdocs"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/backstage-mcp.mjs --banner:js='#!/usr/bin/env node' --define:__MCP_VERSION__=$(node -p \"JSON.stringify(require('./package.json').version)\")",
    "start": "node dist/backstage-mcp.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
