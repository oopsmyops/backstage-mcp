{
  "name": "@oopsmyops/backstage-plugin-assistant",
  "version": "0.2.3",
  "description": "Backstage frontend plugin providing an AI chat assistant widget with auto-discovery support",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oopsmyops/backstage-mcp.git",
    "directory": "plugins/backstage-assistant"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "assistant",
    "pluginPackages": [
      "@oopsmyops/backstage-plugin-assistant"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "tsc -p tsconfig.build.json && backstage-cli package build",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/core-components": "^0.16.4",
    "@backstage/frontend-plugin-api": "^0.16.2",
    "@backstage/theme": "^0.6.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "react-markdown": "^8.0.7"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^17.0.0 || ^18.0.0",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "files": [
    "dist"
  ]
}
