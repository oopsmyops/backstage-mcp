{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-types",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "outDir": "dist-types",
    "rootDir": ".",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
