{
  "name": "@oopsmyops/backstage-plugin-assistant-backend",
  "version": "0.2.0",
  "description": "Backstage backend plugin providing an AI assistant with catalog, scaffolder, and TechDocs tools",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oopsmyops/backstage-mcp.git",
    "directory": "plugins/backstage-assistant-backend"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "assistant",
    "pluginPackages": [
      "@oopsmyops/backstage-plugin-assistant-backend"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "tsc -p tsconfig.build.json && backstage-cli package build",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.117",
    "@ai-sdk/azure": "^3.0.74",
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@backstage/backend-plugin-api": "^1.1.0",
    "@backstage/catalog-client": "^1.9.0",
    "@backstage/errors": "^1.2.6",
    "ai": "^6.0.204",
    "express": "^4.21.0",
    "express-promise-router": "^4.1.1"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.1.0",
    "@backstage/cli": "^0.36.2",
    "@types/express": "^4.17.21",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ]
}
