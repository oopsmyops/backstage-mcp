# ============================================================
# Backstage MCP Server Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Required ---
BACKSTAGE_BASE_URL=https://your-backstage.example.com
BACKSTAGE_TOKEN=your-service-account-token

# --- Transport ---
# "stdio"  — for Claude Desktop, Cursor, VS Code (default)
# "http"   — for remote/production deployment
MCP_TRANSPORT=stdio

# --- HTTP transport settings (only used when MCP_TRANSPORT=http) ---
PORT=3000
HOST=127.0.0.1

# --- Performance ---
# Cache TTL in seconds (0 = disabled)
CACHE_TTL_SECONDS=60
# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=10000
